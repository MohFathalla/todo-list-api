<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml
  الهدف: تعريف المشروع والمكتبات المطلوبة لتنفيذ بنود الـ Brief:
    - Spring Boot Web  -> بناء REST API (Add/View/Edit/Delete للـ Category والـ Task)
    - Spring Data JPA  -> التعامل مع قاعدة بيانات Oracle (Entities, Repositories)
    - Oracle JDBC      -> الاتصال الفعلي بـ Oracle ("store the data in an Oracle database")
    - Validation       -> فرض قواعد الإدخال (title مطلوب، due date ماينفعش في الماضي)
    - springdoc-openapi -> توليد واجهة Swagger ("Add Swagger so the API can be tried out")
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>todo-api</artifactId>
    <version>1.0.0</version>
    <name>todo-api</name>
    <description>To-Do List API - Java / Spring Boot / Oracle (task brief implementation)</description>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- REST endpoints: Category/Task controllers -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Repositories + paging/filtering ("support paging and filtering by status or category") -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation: title not blank, dueDate not in the past, status valid enum -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Oracle JDBC driver: "store the data in an Oracle database" -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
        </dependency>

        <!-- Swagger UI: "Add Swagger so the API can be tried out right from the browser" -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Removes repetitive getters/setters/constructors boilerplate, keeps entities/DTOs readable -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>todo-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
