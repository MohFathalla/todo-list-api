{
  "name": "todo-api-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright API test suite for the To-Do List API (Category + Task CRUD, validation, filtering, paging)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed-report": "playwright test --reporter=list,html",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:categories": "playwright test tests/categories.spec.ts",
    "test:tasks": "playwright test tests/tasks.spec.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
